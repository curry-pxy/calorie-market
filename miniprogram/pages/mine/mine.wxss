.page {
  padding: 12px;
}

.form-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 2px;
}

.form-item {
  flex: 1 1 100%;
  min-width: 0;
}

.picker {
  display: flex;
  align-items: center;
  min-height: 40px;
}

.bmr-card {
  border-left: 3px solid #f0b90b;
}

.bmr-big {
  font-size: 26px;
  font-weight: 700;
  color: #f0b90b;
}

.bmr-note {
  font-size: 11px;
  margin-top: 4px;
  line-height: 1.6;
}

.stat-grid {
  display: flex;
  gap: 8px;
  text-align: center;
}

.st {
  flex: 1;
  background: #0e1420;
  border: 1px solid #222c3f;
  border-radius: 10px;
  padding: 10px 4px;
}

.st-label {
  display: block;
  font-size: 11px;
  color: #8b96ab;
}

.st-num {
  display: block;
  font-size: 18px;
  font-weight: 600;
  margin-top: 4px;
}

.st-num.ok {
  color: #0bbf6b;
}

.custom-row {
  display: flex;
  align-items: center;
  padding: 9px 0;
  font-size: 13px;
  border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
}

.cn {
  flex: 1;
}

.ct {
  font-size: 11px;
  color: #8b96ab;
  width: 64px;
}

.cx {
  color: #5f6a7e;
  padding: 2px 4px 2px 12px;
}

.profile-card {
  padding: 14px 12px;
}

.profile-row {
  display: flex;
  align-items: center;
}

.profile-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #1c2740;
  border: 1px solid #2a3857;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  margin-right: 12px;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 15px;
  font-weight: 600;
}

.profile-sub {
  font-size: 12px;
  margin-top: 4px;
}

.profile-arrow {
  color: #5f6a7e;
  font-size: 24px;
  margin-left: 8px;
  line-height: 1;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 16px;
  right: 16px;
  top: 8%;
  z-index: 91;
  background: #131a28;
  border: 1px solid #222c3f;
  border-radius: 16px;
  padding: 16px 14px 14px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
}

.sheet-title {
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  margin-bottom: 14px;
}

.sheet-col {
  flex: 1 1 46%;
  min-width: 0;
}

.sheet-actions {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.btn-ghost {
  flex: 1;
  background: #0e1420;
  border: 1px solid #222c3f;
  color: #8b96ab;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 600;
  padding: 12px;
  text-align: center;
  box-sizing: border-box;
}

.sheet-save {
  flex: 1;
  padding: 12px;
}
