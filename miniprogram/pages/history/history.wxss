.page {
  padding: 12px;
}

.seg {
  display: flex;
  background: #0e1420;
  border: 1px solid #222c3f;
  border-radius: 10px;
  padding: 3px;
  margin-bottom: 10px;
}

.seg-item {
  flex: 1;
  text-align: center;
  color: #8b96ab;
  font-size: 13px;
  padding: 7px 0;
  border-radius: 8px;
}

.seg-item.active {
  background: #3b82f6;
  color: #ffffff;
}

.chart-card {
  padding: 10px;
}

.chart-stats {
  font-size: 12px;
  color: #8b96ab;
  padding: 2px 2px 8px;
}

.kline {
  width: 100%;
  height: 320px;
}

.legend {
  display: flex;
  gap: 14px;
  font-size: 11px;
  color: #8b96ab;
  padding-top: 8px;
}

.dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 2px;
  margin-right: 4px;
}

.dot.red { background: #f23645; }
.dot.green { background: #0bbf6b; }
.dot.yellow { background: #f0b90b; }
