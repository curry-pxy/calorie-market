.page {
  padding: 8px 12px 30px;
}

.app-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 6px 2px 14px;
}

.app-title {
  font-size: 20px;
  font-weight: 700;
}

.app-sub {
  font-size: 12px;
  margin-top: 3px;
}

.badge {
  font-size: 12px;
  padding: 3px 10px;
  border-radius: 999px;
  font-weight: 600;
}

.badge-proto {
  color: #f0b90b;
  border: 1px solid rgba(240, 185, 11, 0.4);
  background: rgba(240, 185, 11, 0.08);
}

.badge-ok {
  color: #0bbf6b;
  background: rgba(11, 191, 107, 0.13);
  border: 1px solid rgba(11, 191, 107, 0.35);
}

.badge-wip {
  color: #f0b90b;
  background: rgba(240, 185, 11, 0.12);
  border: 1px solid rgba(240, 185, 11, 0.35);
}

.badge-bad {
  color: #f23645;
  background: rgba(242, 54, 69, 0.13);
  border: 1px solid rgba(242, 54, 69, 0.35);
}

.summary {
  border-top: 1px solid rgba(11, 191, 107, 0.35);
}

.summary-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.label {
  font-size: 12px;
}

.net-line {
  display: flex;
  align-items: baseline;
  margin-top: 2px;
}

.net-big {
  font-size: 38px;
  font-weight: 700;
  line-height: 1.1;
}

.goal-side {
  text-align: right;
}

.goal-text {
  font-size: 12px;
  margin-top: 6px;
}

.streak {
  font-size: 12px;
  color: #f0b90b;
  margin-top: 5px;
}

.meter {
  height: 7px;
  border-radius: 99px;
  background: #232d40;
  margin: 12px 0 10px;
  overflow: hidden;
}

.meter-bar {
  height: 100%;
  border-radius: 99px;
  background: #0a9e58;
  transition: width 0.3s ease;
}

.meter-bar.up {
  background: #f23645;
}

.summary-stats {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #8b96ab;
}

.summary-stats .num {
  color: #e8edf6;
  font-weight: 600;
}

.board {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 12px;
}

.cell {
  flex: 1 1 45%;
  min-width: 45%;
  background: #0e1420;
  border: 1px solid #222c3f;
  border-radius: 12px;
  padding: 10px 12px;
  position: relative;
  box-sizing: border-box;
}

.board .empty {
  width: 100%;
}

.cell::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10px;
  bottom: 10px;
  width: 3px;
  border-radius: 3px;
}

.cell-up::before {
  background: #f23645;
}

.cell-down::before {
  background: #0bbf6b;
}

.cell-name {
  font-size: 13px;
  color: #8b96ab;
}

.cell-val {
  font-size: 20px;
  font-weight: 700;
  margin-top: 3px;
}

.cell-sub {
  font-size: 11px;
  color: #5f6a7e;
  margin-top: 3px;
}

.board-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4px 2px 10px;
}

.board-title {
  font-size: 15px;
  font-weight: 700;
}

.seg {
  display: flex;
  background: #0e1420;
  border: 1px solid #222c3f;
  border-radius: 9px;
  overflow: hidden;
}

.seg-item {
  font-size: 12px;
  color: #8b96ab;
  padding: 5px 13px;
}

.seg-on {
  background: #2563eb;
  color: #ffffff;
}

.map {
  position: relative;
  width: 100%;
  height: 320px;
  background: #0e1420;
  border: 1px solid #222c3f;
  border-radius: 12px;
  margin-bottom: 10px;
  overflow: hidden;
}

.map .empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 45%;
}

.map-tile {
  position: absolute;
  box-sizing: border-box;
  border: 1px solid #0a0e14;
  border-radius: 3px;
  overflow: hidden;
  padding: 5px 6px;
}

.tile-up {
  background: linear-gradient(160deg, rgba(242, 54, 69, 0.92), rgba(242, 54, 69, 0.55));
}

.tile-down {
  background: linear-gradient(160deg, rgba(11, 191, 107, 0.9), rgba(11, 191, 107, 0.52));
}

.map-hover {
  opacity: 0.72;
}

.map-name {
  font-size: 11px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.3;
}

.map-val {
  font-size: 13px;
  font-weight: 700;
  color: #ffffff;
  margin-top: 3px;
}

.map-legend {
  display: flex;
  align-items: center;
  font-size: 11px;
  color: #8b96ab;
  margin: 0 4px 14px;
}

.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 2px;
  margin: 0 5px 0 12px;
}

.legend-dot:first-child {
  margin-left: 0;
}

.legend-red {
  background: #f23645;
}

.legend-green {
  background: #0bbf6b;
}

.legend-note {
  margin-left: auto;
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 7px 0;
  font-size: 13px;
}

.rank-row + .rank-row {
  border-top: 1px dashed rgba(255, 255, 255, 0.06);
}

.rank-no {
  width: 26px;
  color: #8b96ab;
  font-size: 12px;
}

.rank-name {
  width: 76px;
}

.rank-track {
  flex: 1;
  height: 6px;
  background: #1c2436;
  border-radius: 99px;
  overflow: hidden;
}

.rank-bar {
  height: 100%;
  border-radius: 99px;
}

.rank-bar.up {
  background: #f23645;
}

.rank-bar.down {
  background: #0bbf6b;
}

.rank-val {
  width: 76px;
  text-align: right;
  font-weight: 600;
}

.record-row {
  display: flex;
  align-items: center;
  padding: 8px 0;
  font-size: 13px;
}

.record-row + .record-row {
  border-top: 1px dashed rgba(255, 255, 255, 0.06);
}

.rec-time {
  width: 44px;
  color: #8b96ab;
  font-size: 12px;
}

.rec-name {
  flex: 1;
}

.rec-kcal {
  font-weight: 600;
}

.rec-del {
  color: #5f6a7e;
  padding: 2px 4px 2px 10px;
}

.tag {
  font-size: 10px;
  color: #8b96ab;
  border: 1px solid #222c3f;
  border-radius: 4px;
  padding: 0 4px;
  margin-left: 4px;
}

.fab {
  position: fixed;
  right: 20px;
  bottom: 100px;
  z-index: 30;
  width: 118px;
  height: 46px;
  box-sizing: border-box;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 10px 24px rgba(37, 99, 235, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.fab-hide {
  position: absolute;
  top: -7px;
  right: -5px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #1b2537;
  border: 1px solid #39475f;
  color: #8b96ab;
  font-size: 12px;
  line-height: 18px;
  text-align: center;
  z-index: 2;
}

.fab-restore {
  position: fixed;
  right: 20px;
  bottom: 100px;
  z-index: 30;
  width: 30px;
  height: 30px;
  box-sizing: border-box;
  border-radius: 50%;
  border: 1px solid rgba(122, 167, 247, 0.5);
  background: rgba(37, 99, 235, 0.18);
  color: #7aa7f7;
  font-size: 18px;
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
