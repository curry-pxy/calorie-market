<view class="page">
  <view class="hero">
    <view class="logo">📉</view>
    <view class="title">减肥行情</view>
    <view class="muted sub">像看大盘一样管理每天的体重和热量</view>
  </view>

  <view class="card">
    <view class="wx-btn" bindtap="wxLogin">
      <text class="wx-icon">💚</text>
      <text>微信一键登录</text>
    </view>
  </view>

  <view class="or-row">
    <view class="or-line"></view>
    <text class="muted or-text">或使用手机号</text>
    <view class="or-line"></view>
  </view>

  <view class="card">
    <view class="seg">
      <view class="seg-item {{mode === 'login' ? 'seg-on' : ''}}" data-mode="login" bindtap="switchMode">登录</view>
      <view class="seg-item {{mode === 'register' ? 'seg-on' : ''}}" data-mode="register" bindtap="switchMode">注册</view>
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入 11 位手机号" placeholder-class="ph" value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="input" password="{{true}}" maxlength="20" placeholder="6-20 位密码" placeholder-class="ph" value="{{password}}" bindinput="onPassword" />
    </view>
    <view class="btn-primary" bindtap="submit">{{mode === 'login' ? '登 录' : '注册并登录'}}</view>
    <view class="muted hint">{{mode === 'register' ? '注册后自动登录，并为你创建默认板块' : '还没有账号？点上方「注册」即可创建'}}</view>
  </view>
</view>
