<view class="page">
  <view class="card">
    <view class="form-row">
      <view class="form-item">
        <text class="form-label">板块</text>
        <picker range="{{sectorNames}}" value="{{sectorIndex}}" bindchange="onSector">
          <view class="input picker">{{sectorNames[sectorIndex]}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">{{kcalLabel}} (kcal)</text>
        <input class="input" type="number" placeholder="如 360" value="{{kcal}}" bindinput="onKcal" />
      </view>
    </view>
    <view class="form-row">
      <view class="form-item">
        <text class="form-label">名称</text>
        <input class="input" placeholder="如 燕麦牛奶" value="{{name}}" bindinput="onName" />
      </view>
    </view>
    <view class="form-row">
      <view class="form-item">
        <text class="form-label">{{qtyLabel}}</text>
        <input class="input" placeholder="如 1碗 / 45分钟" value="{{qty}}" bindinput="onQty" />
      </view>
    </view>
    <view class="btn-primary" bindtap="save">保存记录</view>
  </view>
</view>
